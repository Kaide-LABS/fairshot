    "Job_Requisition": {
      "endpoint": "/ccx/api/recruiting/v38.1/requisitions",
      "description": "Job requisition data",
      "fields": {
        "Job_Requisition_ID": { "type": "string", "nullable": false, "format": "JR-YYYY-NNNN" },
        "Job_Posting_Title": { "type": "string", "nullable": false },
        "Supervisory_Organization_Reference": { "type": "string", "nullable": false, "description": "Department/org WID" },
        "Hiring_Manager_Reference": { "type": "string", "nullable": false, "format": "Employee_ID" },
        "Job_Profile_Reference": { "type": "string", "nullable": true, "description": "Job profile WID" },
        "Time_Type_Reference": { "type": "string", "nullable": false, "enum": ["Full_Time", "Part_Time"] },
        "Worker_Type_Reference": { "type": "string", "nullable": false, "enum": ["Employee", "Contingent_Worker", "Intern"] },
        "Management_Level_Reference": { "type": "string", "nullable": true, "enum": ["Individual_Contributor", "Manager", "Director", "VP", "Executive"] },
