{
  "ats_name": "Workday Enterprise HCM",
  "ats_version": "v38.1",
  "api_base": "/ccx/api/recruiting/v38.1",
  "auth_type": "OAuth2_SAML",
  "entities": {
    "Candidate": {
      "endpoint": "/ccx/api/recruiting/v38.1/candidates",
      "description": "Core candidate identity, application, and resume data",
      "fields": {
        "Candidate_ID": { "type": "string", "nullable": false },
        "Name_Data": {
          "type": "object",
          "fields": {
            "First_Name": { "type": "string", "nullable": false, "max_length": 100 },
            "Last_Name": { "type": "string", "nullable": false, "max_length": 100 },
            "Middle_Name": { "type": "string", "nullable": true },
            "Secondary_Last_Name": { "type": "string", "nullable": true }
          }
        },
        "Contact_Data": {
          "type": "object",
          "fields": {
            "Email_Address": { "type": "string", "nullable": false, "format": "email" },
            "Phone_Number": { "type": "string", "nullable": true },
            "Location_Data": {
              "type": "object",
              "fields": {
                "Address_Line_1": { "type": "string", "nullable": true },
                "City": { "type": "string", "nullable": true },
                "Country_Reference": { "type": "string", "nullable": true, "format": "ISO_3166-1_Alpha-2", "description": "References CountryObject by ISO code" },
                "Country_Region_Reference": { "type": "string", "nullable": true, "description": "State/province code" },
                "Postal_Code": { "type": "string", "nullable": true }
              }
            },
            "Website_Data": {
              "type": "array",
              "items": {
                "type": "object",
                "fields": {
                  "URL_Address": { "type": "string", "nullable": false, "format": "url" }
                }
              }
            }
          }
        },
        "Social_Media_Account_Data": {
          "type": "array",
          "items": {
            "type": "object",
            "fields": {
              "Social_Network_Type_Reference": { "type": "string", "nullable": false, "description": "e.g. LinkedIn, Twitter" },
              "Social_Network_Account_URL": { "type": "string", "nullable": false, "format": "url" }
            }
          }
        },
        "Status_Data": {
          "type": "object",
          "fields": {
            "Do_Not_Hire": { "type": "boolean", "nullable": false, "default": false },
            "Withdrawn": { "type": "boolean", "nullable": false, "default": false }
          }
        },
        "Job_Application_Data": {
          "type": "array",
          "items": {
            "type": "object",
            "fields": {
              "Job_Requisition_Reference": { "type": "string", "nullable": false, "format": "WID", "description": "References Job_Requisition_EnabledObject" },
              "Job_Application_Date": { "type": "string", "nullable": false, "format": "dateTime" },
              "Stage_Reference": { "type": "string", "nullable": true, "description": "Recruiting stage WID" },
              "Disposition_Reference": { "type": "string", "nullable": true },
              "Status_Timestamp": { "type": "string", "nullable": true, "format": "dateTime" },
              "Source_Reference": { "type": "string", "nullable": true, "description": "Applicant source (LinkedIn, Indeed, etc.)" },
              "Referred_By_Worker_Reference": { "type": "string", "nullable": true, "format": "Employee_ID" },
              "Personal_Information_Data": {
                "type": "object",
                "fields": {
                  "Gender_Reference": { "type": "string", "nullable": true, "enum": ["Male", "Female", "Not_Declared"] },
                  "Hispanic_or_Latino": { "type": "boolean", "nullable": true },
                  "Disability_Status_Reference": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "Resume_Data": {
          "type": "object",
          "fields": {
            "Summary": { "type": "string", "nullable": true },
            "Skill_Data": {
              "type": "array",
              "items": {
                "type": "object",
                "fields": {
                  "Skill_Name": { "type": "string", "nullable": false }
                }
              }
            },
            "Education_Data": {
              "type": "array",
              "items": {
                "type": "object",
                "fields": {
                  "School_Name": { "type": "string", "nullable": false },
                  "Degree_Reference": { "type": "string", "nullable": true, "description": "Degree WID" },
                  "Field_of_Study_Reference": { "type": "string", "nullable": true },
                  "First_Year_Attended": { "type": "integer", "nullable": true },
                  "Last_Year_Attended": { "type": "integer", "nullable": true },
                  "Grade_Average": { "type": "string", "nullable": true }
                }
              }
            },
            "Experience_Data": {
              "type": "array",
              "items": {
                "type": "object",
                "fields": {
                  "Company_Name": { "type": "string", "nullable": false },
                  "Title": { "type": "string", "nullable": false },
                  "Location": { "type": "string", "nullable": true },
                  "Start_Month": { "type": "integer", "nullable": true },
                  "Start_Year": { "type": "integer", "nullable": false },
                  "End_Month": { "type": "integer", "nullable": true },
                  "End_Year": { "type": "integer", "nullable": true },
                  "Currently_Work_Here": { "type": "boolean", "nullable": false, "default": false },
                  "Description": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "CF_Internal_Candidate_Flag": { "type": "boolean", "nullable": false, "default": false, "description": "Custom field - internal hire flag" },
        "CF_Screening_Score_v2": { "type": "float", "nullable": true, "min": 0, "max": 100, "description": "Custom field - screening score (version 2)" },
        "CF_Diversity_Flag_DO_NOT_USE": { "type": "boolean", "nullable": true, "description": "DEPRECATED custom field" },
        "CF_Notes_DEPRECATED": { "type": "string", "nullable": true, "description": "Deprecated - use Candidate Comments" },
        "CF_Preferred_Language": { "type": "string", "nullable": true, "format": "ISO639-1" },
        "CF_Timezone_v2_Final": { "type": "string", "nullable": true, "format": "IANA_timezone" },
        "CF_Skills_Tags": { "type": "string", "nullable": true, "format": "semicolon_delimited", "description": "Custom field - semicolon-delimited skill tags" }
      },
