        "web.twitter": { "type": "string", "nullable": true, "description": "Twitter handle" },
        "web.website": { "type": "string", "nullable": true, "description": "Personal website URL" },
        "web.skype": { "type": "string", "nullable": true, "description": "Skype ID" },
